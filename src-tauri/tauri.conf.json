{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PostgreSQL Profiles",
  "version": "0.1.0",
  "identifier": "com.postgres-mcp.profiles",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "title": "PostgreSQL MCP Profiles Manager",
        "width": 1100,
        "height": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {}
}
